<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:orientation="vertical"
    android:gravity="bottom"
    android:padding="20dp"
    android:background="@drawable/bg_launch">

    <!-- App logo -->
    <ImageView
        android:layout_width="59dp"
        android:layout_height="59dp"
        android:layout_marginBottom="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_pocket_watch" />

    <!-- App name — white -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <!-- Tagline — white faded -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tagline"
        android:textSize="11sp"
        android:textColor="#AAFFFFFF"
        android:layout_marginTop="2dp"/>

    <!--
        Logged in user's name shown here
        TODO: your team replaces "Welcome, User" with
        USER.first_name + " " + USER.surname from session
    -->
    <TextView
        android:id="@+id/tv_drawer_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, User"
        android:textSize="11sp"
        android:textColor="#80FFFFFF"
        android:layout_marginTop="6dp"/>

</LinearLayout>