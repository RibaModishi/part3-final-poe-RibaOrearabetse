<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <!-- ══ TOOLBAR ══ -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_menu_hamburger"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_desc_menu"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reports_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#00BCD4"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/btn_logout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logout"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_desc_logout"/>
    </LinearLayout>

    <!-- ══ SCROLL CONTENT ══ -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── DATE RANGE CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_date_range"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="14dp"/>

                <!-- FROM DATE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_from_date"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_from_date"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_date"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/input_default"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#AAAAAA"
                    android:layout_marginBottom="14dp"/>

                <!-- TO DATE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_to_date"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_to_date"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_date"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/input_default"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#AAAAAA"
                    android:layout_marginBottom="14dp"/>

                <!-- Stats 2x2 grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Left column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <!-- Total Spent -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/input_default"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_total_spent"
                                android:textSize="11sp"
                                android:textColor="#888888"/>

                            <TextView
                                android:id="@+id/tv_total_spent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R0.00"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <!-- Avg Daily -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/input_default"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_avg_daily"
                                android:textSize="11sp"
                                android:textColor="#888888"/>

                            <TextView
                                android:id="@+id/tv_avg_daily"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R0.00"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Right column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Transactions -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/input_default"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_transactions"
                                android:textSize="11sp"
                                android:textColor="#888888"/>

                            <TextView
                                android:id="@+id/tv_transactions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <!-- Days -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/input_default"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_days"
                                android:textSize="11sp"
                                android:textColor="#888888"/>

                            <TextView
                                android:id="@+id/tv_days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── TAB CHIPS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_white_rounded"
                android:padding="6dp"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/chip_daily"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/tab_daily"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_chip_active"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/chip_weekly"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/tab_weekly"
                    android:textSize="13sp"
                    android:textColor="#1A1A1A"
                    android:background="@drawable/btn_chip_inactive"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/chip_category"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/tab_category"
                    android:textSize="13sp"
                    android:textColor="#1A1A1A"
                    android:background="@drawable/btn_chip_inactive"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- ── SPENDING TREND CHART CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tv_chart_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spending_trend_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:id="@+id/tv_chart_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spending_trend_sub"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"/>

                <!--
                    Bar chart — shows spending per day/week/category
                -->
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="8dp"/>

                <!--
                    Line chart — shown on Weekly tab
                -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/line_chart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- ── SPENDING BY CATEGORY CARD (Pie/Donut) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spending by Category"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distribution of expenses"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pie_chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"/>

            </LinearLayout>

            <!-- ── CATEGORY BREAKDOWN CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_breakdown_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_breakdown_sub"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"/>

                <!--
                    Each row = one category with progress bar
                    Built dynamically in ReportsFragment
                -->
                <LinearLayout
                    android:id="@+id/breakdown_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>