<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Category icon -->
    <TextView
        android:id="@+id/tv_budget_cat_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:textSize="20sp"
        android:background="@drawable/btn_icon_circle"
        android:layout_marginEnd="12dp"/>

    <!-- Category name -->
    <TextView
        android:id="@+id/tv_budget_cat_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"/>

    <!--
        CATEGORY.total_allocated for this category
        Pre-filled from Category page if set there
        Also saves back to CATEGORY.total_allocated when Budget saved
        TODO: your team syncs this bidirectionally:
        - Read: CATEGORY.total_allocated WHERE category_id = x
        - Write: UPDATE CATEGORY SET total_allocated = x
                 AND INSERT/UPDATE BUDGET for this category
    -->
    <EditText
        android:id="@+id/et_cat_budget_limit"
        android:layout_width="100dp"
        android:layout_height="44dp"
        android:inputType="numberDecimal"
        android:background="@drawable/input_default"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="13sp"
        android:textColor="#1A1A1A"
        android:gravity="end|center_vertical"/>

</LinearLayout>