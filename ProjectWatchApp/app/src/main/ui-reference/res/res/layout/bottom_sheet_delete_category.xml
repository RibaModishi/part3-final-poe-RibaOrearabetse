<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bottom_rounded"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="32dp"
    android:gravity="center">

    <!-- Warning icon -->
    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:text="🗑️"
        android:textSize="32sp"
        android:gravity="center"
        android:background="@drawable/btn_delete_circle"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete Category?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="8dp"/>

    <!--
        Warning — EXPENSE table has FK to CATEGORY with Delete Restricted
        Tell user expenses must be moved/deleted first
        [category_name] filled dynamically from selected CATEGORY.category_name
    -->
    <TextView
        android:id="@+id/tv_delete_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You are about to delete [category_name]. All expenses linked to this category must be reassigned or deleted first."
        android:textSize="13sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Confirm delete -->
    <Button
        android:id="@+id/btn_confirm_delete"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Yes, Delete"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#E53935"
        android:stateListAnimator="@null"
        android:layout_marginBottom="10dp"/>

    <!-- Cancel -->
    <Button
        android:id="@+id/btn_cancel_delete"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Cancel"
        android:textColor="#1A1A1A"
        android:textSize="15sp"
        android:background="@drawable/input_default"
        android:stateListAnimator="@null"/>

</LinearLayout>