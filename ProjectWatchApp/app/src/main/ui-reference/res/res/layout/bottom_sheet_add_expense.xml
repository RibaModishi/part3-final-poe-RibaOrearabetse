<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bottom_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- Close + Title row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center">

                <!--
                    Title changes based on which category was tapped
                    e.g. "Add Expense to [CATEGORY.category_name]"
                    Set dynamically in CategoryFragment.kt
                -->
                <TextView
                    android:id="@+id/tv_sheet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Expense to [Category Name]"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_gravity="center_horizontal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log an expense for this category"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_add_expense"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/btn_icon_circle"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:padding="6dp"
                android:contentDescription="Close"/>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="18dp"/>

        <!-- AMOUNT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AMOUNT *"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#444444"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <!--
            Binds to: EXPENSE.amount
            Required field — decimal number
        -->
        <EditText
            android:id="@+id/et_expense_amount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="R 0.00"
            android:inputType="numberDecimal"
            android:background="@drawable/input_default"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:textColor="#1A1A1A"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="16dp"/>

        <!-- DATE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATE *"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#444444"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <!--
            Binds to: EXPENSE.date_logged
            Gold border = required and highlighted
            Format: yyyy/mm/dd
        -->
        <EditText
            android:id="@+id/et_expense_date"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="yyyy/mm/dd"
            android:inputType="date"
            android:background="@drawable/input_gold_border"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:textColor="#1A1A1A"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="16dp"/>

        <!-- DESCRIPTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION *"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#444444"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <!--
            Binds to: EXPENSE.description
            Optional user notes field
        -->
        <EditText
            android:id="@+id/et_expense_description"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="What did you spend on?"
            android:inputType="text"
            android:background="@drawable/input_default"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:textColor="#1A1A1A"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="16dp"/>

        <!-- RECEIPT PHOTO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECEIPT PHOTO (OPTIONAL)"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#444444"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <!-- Upload area — triggers image picker in fragment -->
        <LinearLayout
            android:id="@+id/upload_receipt_area"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_upload_box"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textSize="26sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload a photo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A6B3C"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!--
            Saves to EXPENSE table:
              - user_id = logged in user
              - category_id = selected category (passed from item click)
              - amount = et_expense_amount
              - date_logged = et_expense_date
              - description = et_expense_description
        -->
        <Button
            android:id="@+id/btn_save_expense"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Add Expense"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_green_rounded"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>