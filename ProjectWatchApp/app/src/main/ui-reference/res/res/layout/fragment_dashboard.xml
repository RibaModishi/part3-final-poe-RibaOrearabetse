<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <!-- ══ TOOLBAR ══ -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_menu_hamburger"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dashboard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#00BCD4"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/btn_logout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logout"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Logout"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── SECTION: WELCOME BANNER (Green card) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_launch"
                android:padding="20dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning 👋"
                    android:textSize="13sp"
                    android:textColor="#AAFFFFFF"/>

                <TextView
                    android:id="@+id/tv_dash_welcome_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back, @username"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Here's your financial overview for today"
                    android:textSize="12sp"
                    android:textColor="#80FFFFFF"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- ── SECTION: LEVEL PROGRESS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_dash_level_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Level 1: Beginner Budgeter"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:id="@+id/tv_dash_xp_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50 points to apprentice"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_dash_xp_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50 pts"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_progress_track">
                    <View
                        android:id="@+id/progress_dash_xp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_progress_yellow"
                        android:scaleX="0.5"
                        android:pivotX="0"/>
                </FrameLayout>
            </LinearLayout>

            <!-- ── SECTION: ACHIEVEMENTS row (Image 2 middle) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/card_dash_goals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_white_rounded"
                    android:padding="20dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯"
                        android:textSize="24sp"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:id="@+id/tv_dash_goals_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goals"
                        android:textSize="12sp"
                        android:textColor="#888888"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_dash_badges"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_white_rounded"
                    android:padding="20dp"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎖️"
                        android:textSize="24sp"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:id="@+id/tv_dash_badges_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Badges"
                        android:textSize="12sp"
                        android:textColor="#888888"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── SECTION: MONTHLY BUDGET SUMMARY (Image 2 bottom) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/btn_cyan">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Monthly Budget Summary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <Button
                        android:id="@+id/btn_dash_update_budget"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="Update"
                        android:textSize="10sp"
                        android:textColor="#1A1A1A"
                        android:background="#FFFFFF"
                        android:stateListAnimator="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/input_default"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Budget"
                            android:textSize="10sp"
                            android:textColor="#888888"/>
                        <TextView
                            android:id="@+id/tv_dash_budget_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R500k"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/input_default"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginStart="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remaining"
                            android:textSize="10sp"
                            android:textColor="#888888"/>
                        <TextView
                            android:id="@+id/tv_dash_remaining_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R400k"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#43A047"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/input_default"
                        android:padding="8dp"
                        android:layout_marginStart="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Spent"
                            android:textSize="10sp"
                            android:textColor="#888888"/>
                        <TextView
                            android:id="@+id/tv_dash_spent_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R300k"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#E53935"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ── SECTION: CATEGORY SPENDING (Image 1 top) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category Spending"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recently added Categories"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:textColor="#007A8A"/>
                </LinearLayout>
                <Button
                    android:id="@+id/btn_dash_add_cat"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ Add Category"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_cyan"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_dash_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"/>

            <!-- ── SECTION: RECENT EXPENSES (Image 1 bottom) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Expenses"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recently logged transactions"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:textColor="#007A8A"/>
                </LinearLayout>
                <Button
                    android:id="@+id/btn_dash_view_all"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="View Expenses"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_cyan"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_dash_expenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="8dp"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
