<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_white_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/textViewCategoryEmoji"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/btn_icon_circle"
        android:gravity="center"
        android:text="🛒"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewCategoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A1A1A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewCategoryMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A8A8A"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonCategoryAddExpense"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_icon_circle"
                android:contentDescription="@string/category_action_add_expense"
                android:padding="6dp"
                android:src="@drawable/ic_view" />

            <ImageButton
                android:id="@+id/buttonCategoryEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_icon_circle"
                android:contentDescription="@string/category_action_edit"
                android:padding="6dp"
                android:src="@drawable/ic_edit_vector" />

            <ImageButton
                android:id="@+id/buttonCategoryDelete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/btn_delete_circle"
                android:contentDescription="@string/category_action_delete"
                android:padding="6dp"
                android:src="@drawable/ic_close_vector" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewCategorySpent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
