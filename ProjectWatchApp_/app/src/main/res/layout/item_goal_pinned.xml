<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_white_rounded"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textViewPinnedGoalName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/buttonPinnedGoalPin"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/input_default"
            android:contentDescription="@string/action_toggle_pin_goal"
            android:padding="7dp"
            android:src="@drawable/ic_dash_menu" />

        <ImageButton
            android:id="@+id/buttonPinnedGoalDelete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/input_default"
            android:contentDescription="@string/action_delete_goal"
            android:padding="7dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewPinnedGoalMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#7A7A7A"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/textViewPinnedGoalProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#1A1A1A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressPinnedGoal"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/textViewPinnedGoalRemaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#7A7A7A"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editTextPinnedGoalDeposit"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/input_default"
            android:hint="Update amount"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#1A1A1A"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonPinnedGoalUpdate"
            android:layout_width="76dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_cyan"
            android:text="Update"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonPinnedGoalHistory"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_cyan"
        android:text="Progress History"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
