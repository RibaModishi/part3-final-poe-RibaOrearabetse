<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bottom_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/category_dialog_add_title_full"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="@string/category_dialog_add_subtitle"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonCloseAddCategorySheet"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_icon_circle"
            android:contentDescription="@string/action_cancel"
            android:padding="7dp"
            android:src="@drawable/ic_close_vector" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#F0F0F0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/category_label_name"
        android:textColor="#444444"
        android:textSize="10sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextSheetCategoryName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/input_gold_border"
        android:hint="@string/category_hint_name"
        android:inputType="textCapWords"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#AAAAAA"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/category_label_color"
            android:textColor="#444444"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonAddIconSheet"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/input_default"
            android:text="@string/category_add_icon"
            android:textAllCaps="false"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <View android:id="@+id/colorChip1" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip3" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip4" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip5" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip6" android:layout_width="24dp" android:layout_height="24dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <View android:id="@+id/colorChip7" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip8" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip9" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip10" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip11" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" />
        <View android:id="@+id/colorChip12" android:layout_width="24dp" android:layout_height="24dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/category_label_budget_optional"
        android:textColor="#444444"
        android:textSize="10sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextSheetBudget"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/input_default"
        android:hint="@string/category_budget_hint"
        android:inputType="numberDecimal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#AAAAAA"
        android:textSize="14sp" />

    <Button
        android:id="@+id/buttonSaveCategorySheet"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/btn_cyan"
        android:text="@string/action_add_category_short"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
