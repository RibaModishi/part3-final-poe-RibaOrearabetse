<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <!-- ══ TOOLBAR ══ -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_menu_hamburger"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expenses"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#00BCD4"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/btn_logout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logout"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Logout"/>
    </LinearLayout>

    <!-- ══ SCROLL CONTENT ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── FILTER CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Filter Expenses"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>

                    <TextView
                        android:id="@+id/tv_toggle_filters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hide Filters"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#00BCD4"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CATEGORY"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#444444"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"/>

                    <Spinner
                        android:id="@+id/spinner_category"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_default"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FROM DATE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#444444"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/et_from_date"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="yyyy/mm/dd"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:background="@drawable/input_default"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#AAAAAA"
                        android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TO DATE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#444444"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/et_to_date"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="yyyy/mm/dd"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:background="@drawable/input_default"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#AAAAAA"
                        android:layout_marginBottom="14dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_filter_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Showing 0 · Total: R0.00"
                        android:textSize="11sp"
                        android:textColor="#666666"/>

                    <Button
                        android:id="@+id/btn_clear_filters"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Clear Filters"
                        android:textSize="11sp"
                        android:textColor="#1A1A1A"
                        android:background="@drawable/input_default"
                        android:stateListAnimator="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── EXPENSE LIST CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="List of Expenses"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:id="@+id/tv_expense_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Expense(s) found"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_expenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
