<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <LinearLayout
        android:id="@+id/toolbarRewards"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/buttonRewardsMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/dashboard_menu_icon_desc"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_menu_hamburger" />

        <TextView
            android:id="@+id/textViewRewardsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/rewards_title"
            android:textColor="#00BCD4"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/buttonRewardsLogout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/dashboard_logout_icon_desc"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_dash_logout" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutRewardsBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarRewards">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/card_white_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textViewRewardsLevelName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Level 1: Beginner Budgeter"
                        android:textColor="#1A1A1A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewRewardsLevelPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 pts"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewRewardsLevelSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/rewards_level_placeholder"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/progressRewardsLevel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/card_white_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Level Journey"
                    android:textColor="#1A1A1A"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your path to mastery"
                    android:textColor="#0997A6"
                    android:textSize="14sp"
                    android:textStyle="italic|bold" />

                <LinearLayout
                    android:id="@+id/layoutRewardsJourney"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/card_white_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Badge Collection"
                    android:textColor="#1A1A1A"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewRewardsBadgeXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rewards_badge_xp_placeholder"
                    android:textColor="#0997A6"
                    android:textSize="14sp"
                    android:textStyle="italic|bold" />

                <LinearLayout
                    android:id="@+id/layoutRewardsBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/card_white_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Statistics"
                    android:textColor="#1A1A1A"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Track your achievements"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/layoutRewardsStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/textViewRewardsLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/loading_rewards"
                android:textColor="#888888"
                android:visibility="gone" />

            <!-- Hidden test award controls preserved -->
            <TextView android:id="@+id/textViewRewardsBadgeList" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <TextView android:id="@+id/textViewTestBadgeLabel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <Spinner android:id="@+id/spinnerRewardBadge" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <Button android:id="@+id/buttonAwardSelectedBadge" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/layoutRewardsBottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/navRewardsDashboard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableTop="@drawable/ic_nav_dashboard"
            android:text="@string/dashboard_nav_goals"
            android:textAllCaps="false"
            android:textColor="#121212"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navRewardsExpenses"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableTop="@drawable/ic_nav_expenses"
            android:text="@string/dashboard_nav_expenses"
            android:textAllCaps="false"
            android:textColor="#121212"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navRewardsCategory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableTop="@drawable/ic_nav_category"
            android:text="@string/dashboard_nav_category"
            android:textAllCaps="false"
            android:textColor="#121212"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navRewardsBudget"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableTop="@drawable/ic_nav_budget"
            android:text="@string/dashboard_nav_budget"
            android:textAllCaps="false"
            android:textColor="#121212"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
