<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_white_rounded"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/layoutFaqQuestionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textViewFaqQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewFaqToggle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/btn_chip_light"
            android:gravity="center"
            android:text="▼"
            android:textColor="#7A7A7A"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewFaqAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#5F5F5F"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
