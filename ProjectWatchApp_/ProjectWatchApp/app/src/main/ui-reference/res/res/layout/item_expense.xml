<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Category icon circle -->
    <TextView
        android:id="@+id/tv_expense_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:textSize="20sp"
        android:background="@drawable/btn_icon_circle"
        android:layout_marginEnd="12dp"/>

    <!-- Description + category · date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!--
            EXPENSE.description
            The note the user wrote when logging the expense
        -->
        <TextView
            android:id="@+id/tv_expense_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"/>

        <!--
            CATEGORY.category_name · EXPENSE.date_logged
            e.g. "Groceries · 2026/03/13"
        -->
        <TextView
            android:id="@+id/tv_expense_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!--
        EXPENSE.amount
        Shown in red with R prefix
        e.g. "R 200.00"
    -->
    <TextView
        android:id="@+id/tv_expense_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#E53935"
        android:layout_marginEnd="10dp"/>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- View expense detail -->
        <ImageView
            android:id="@+id/btn_view_expense"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/btn_icon_circle"
            android:src="@drawable/ic_view"
            android:padding="7dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="View Expense"/>

        <!-- Delete expense -->
        <ImageView
            android:id="@+id/btn_delete_expense"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/btn_delete_circle"
            android:src="@drawable/ic_delete"
            android:padding="7dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Delete Expense"/>
    </LinearLayout>

</LinearLayout>