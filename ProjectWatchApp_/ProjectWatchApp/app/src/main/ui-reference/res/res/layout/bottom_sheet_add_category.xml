<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bottom_rounded"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="32dp">

    <!-- Header row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerInParent="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Category"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_gravity="center_horizontal"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a new expense category"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_add_category"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_icon_circle"
            android:src="@drawable/ic_close"
            android:padding="8dp"
            android:contentDescription="Close"/>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="18dp"/>

    <!-- CATEGORY NAME -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CATEGORY NAME *"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#444444"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_category_name"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="e.g., Groceries, Entertainment"
        android:inputType="text"
        android:background="@drawable/input_gold_border"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="14sp"
        android:textColor="#1A1A1A"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="18dp"/>

    <!-- COLOR row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CATEGORY COLOR"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#444444"
            android:letterSpacing="0.1"/>

        <Button
            android:id="@+id/btn_add_icon"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="+ Add Icon"
            android:textSize="11sp"
            android:textColor="#1A1A1A"
            android:background="@drawable/input_default"
            android:stateListAnimator="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>

    <!-- Color picker grid -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/color_picker_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:flexWrap="wrap"
        app:flexDirection="row"
        app:justifyContent="flex_start"
        app:alignItems="center"/>

    <!-- BUDGET LIMIT -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MONTHLY BUDGET LIMIT (OPTIONAL)"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#444444"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_budget_limit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="R0.00"
        android:inputType="numberDecimal"
        android:background="@drawable/input_default"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="14sp"
        android:textColor="#1A1A1A"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_save_category"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="+ Add Category"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/btn_cyan"
        android:stateListAnimator="@null"/>

</LinearLayout>